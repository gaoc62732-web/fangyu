{
  "name": "@fangyu/api",
  "private": true,
  "version": "0.6.0-dev",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "create-user": "node --env-file=.env --import tsx scripts/create-user.ts",
    "start": "node --env-file=.env dist/main.js"
  },
  "dependencies": {
    "@fangyu/contracts": "workspace:*",
    "@fangyu/domain": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "better-auth": "1.7.6",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0",
    "@fangyu/catalog": "workspace:*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.25.0"
  }
}
